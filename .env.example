# ---- 数据库 ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=all_ontology
# POSTGRES_SSLMODE=require

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@nvidia.com
PGADMIN_PASSWORD=change-me

# ---- 模型 ----
# 各角色只需覆盖与默认值不同的字段，未设置的字段回退到 DEFAULT_MODELS_*
DEFAULT_MODELS_API_KEY=nvapi-your-api-key-here
DEFAULT_MODELS_ENDPOINT=https://integrate.api.nvidia.com/v1
DEFAULT_MODELS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

REASONING_API_KEY=nvapi-your-api-key-here
REASONING_ENDPOINT=https://integrate.api.nvidia.com/v1
REASONING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

NON_REASONING_API_KEY=nvapi-your-api-key-here
NON_REASONING_ENDPOINT=https://integrate.api.nvidia.com/v1
NON_REASONING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# 入库与查询必须使用同一个 embedding 模型
EMBED_API_KEY=nvapi-your-api-key-here
EMBED_ENDPOINT=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/nemotron-3.5-embed-1b

RERANK_API_KEY=nvapi-your-api-key-here
RERANK_ENDPOINT=https://ai.api.nvidia.com/v1/retrieval/nvidia/nemotron-3.5-rerank-8b/reranking
RERANK_MODEL=nvidia/nemotron-3.5-rerank-8b

# ---- 应用 ----
APP_URL=http://localhost:3010
ALL_ONTOLOGY_MCP_PUBLIC_URL=http://localhost:3003
INGESTION_SERVICE_URL=http://localhost:3002

# ---- 登录 ----
ALL_ONTOLOGY_ADMIN_EMAIL=admin@nvidia.com
ALL_ONTOLOGY_ADMIN_PASSWORD=autoontologypassword123
AUTH_SECRET=myverylongsecret123

# ---- 可选 ----
# 外部数据源（dev-tools 导入用）：postgresql:// / snowflake:// / mssql://
# CONNECTION_STRINGS=postgresql://user:password@host:5432/dbname
# 交互式澄清流程
# INTERACTIVE=false
# SQL 执行前校验（默认全部关闭）
# DB_PROBE_PROACTIVE=false
# DB_PROBE_JSONB_PATH_CHECK=false
# DB_PROBE_JOIN_PATH_CHECK=false
# DETECT_VACUOUS_GROUP_BY=true
# KumoRFM 预测（设置 API_KEY 即启用，需上传数据到托管服务）
# KUMO_RFM_API_URL=
# KUMO_RFM_API_KEY=
# 入库巡检间隔（小时）
# INGEST_INTERVAL_HOURS=24
# Connection file picker allowlist. Separate multiple roots with the OS path
# separator (or commas). A Windows UNC share works, e.g. \\fileserver\documents.
# Leave unset to allow ./shared only.
# FILE_SOURCE_ROOTS=\\fileserver\documents;./shared

# Optional parsing folder allowlist. Leave unset to let the parsing picker
# browse every directory the API process can read; set it to the same UNC/path
# list when the deployment should be narrower.
# PARSING_SOURCE_ROOTS=

# Maximum PDFs one shared-folder parsing task may queue.
# PARSING_MAX_SCAN_FILES=1000
